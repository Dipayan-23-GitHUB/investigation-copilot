APP_ENV=development
APP_NAME=Investigation Copilot API
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/investigation_copilot.db
AUTO_CREATE_DB=true
# Set a strong secret outside development. If set, every /api/v1 endpoint requires X-API-Key.
API_ACCESS_KEY=
# In production, restrict this to the exact frontend origin(s), comma-separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GROQ_API_KEY=
# Confirm the chosen model is enabled for your Groq project before deployment.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
MAX_UPLOAD_MB=25
